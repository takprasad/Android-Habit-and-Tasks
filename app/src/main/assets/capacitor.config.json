{
	"appId": "com.example.habittracker",
	"appName": "Habit & Task Tracker",
	"webDir": "public",
	"server": {
		"androidScheme": "https"
	},
	"android": {
		"allowMixedContent": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 0,
			"backgroundColor": "#0F6B5C",
			"showSpinner": false
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_habit",
			"iconColor": "#0F6B5C"
		}
	}
}
